# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api

# Public (client-side) — safe to expose in browser
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Private (server-side only) — NEVER expose in client code
PRIVATE_SUPABASE_URL=https://your-project.supabase.co
PRIVATE_SUPABASE_ANON_KEY=your-anon-key
PRIVATE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Billing (development/testing)
MOCK_PLAN_SEATS=3
